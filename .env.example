# Public site
NEXT_PUBLIC_SITE_URL=https://faizzab.com

# SMTP (Hostinger or other mail account for info@faizzab.com)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=info@faizzab.com
CONTACT_FROM_EMAIL=

# Hostinger MySQL (optional for public site; required for admin portal persistence)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Admin session encryption (min 32 characters). Required in production.
ADMIN_SESSION_SECRET=

# First Super Admin bootstrap (used only with npm run admin:bootstrap)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional analytics — leave blank to disable
NEXT_PUBLIC_ANALYTICS_ID=
